{
  "name": "id-validator-id",
  "version": "1.0.1",
  "description": "Indonesia validators: NIK, NPWP, SIM, Passport, Postal Code, License Plate, plus global Phone/Email",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "data"
  ],
  "dependencies": {
    "@idvalidator/core": "1.0.1",
    "@idvalidator/global-phone": "1.0.1",
    "@idvalidator/global-email": "1.0.1"
  },
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  },
  "license": "MIT",
  "author": "BaimPriyatna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaimPriyatna/id-validator.git",
    "directory": "packages/id"
  },
  "bugs": {
    "url": "https://github.com/BaimPriyatna/id-validator/issues"
  },
  "homepage": "https://github.com/BaimPriyatna/id-validator#readme",
  "keywords": [
    "typescript",
    "validation",
    "id-validator",
    "indonesia",
    "nik",
    "npwp",
    "kode-pos",
    "plat-nomor"
  ]
}
