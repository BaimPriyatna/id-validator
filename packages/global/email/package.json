{
  "name": "@idvalidator/global-email",
  "version": "1.1.0",
  "description": "Global email validator, reused across country packages",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
      "dist",
      "NOTICE"
  ],
  "dependencies": {
    "@idvalidator/core": "1.1.0"
  },
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  },
  "license": "Apache-2.0",
  "author": "BaimPriyatna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaimPriyatna/id-validator.git",
    "directory": "packages/global/email"
  },
  "bugs": {
    "url": "https://github.com/BaimPriyatna/id-validator/issues"
  },
  "homepage": "https://github.com/BaimPriyatna/id-validator#readme",
  "keywords": [
    "typescript",
    "validation",
    "id-validator"
  ],
  "publishConfig": {
    "access": "public"
  }
}
