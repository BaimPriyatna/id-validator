{
  "name": "@idvalidator/core",
  "version": "1.0.1",
  "description": "Shared types, result/error model, and normalization primitives for the id-validator ecosystem",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "dependencies": {},
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  },
  "license": "MIT",
  "author": "BaimPriyatna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaimPriyatna/id-validator.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/BaimPriyatna/id-validator/issues"
  },
  "homepage": "https://github.com/BaimPriyatna/id-validator#readme",
  "keywords": [
    "typescript",
    "validation",
    "id-validator"
  ],
  "publishConfig": {
    "access": "public"
  }
}
